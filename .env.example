# 复制为 .env 后填入真实值：cp .env.example .env
# docker-compose.yml 会读取本文件。.env 已被 .gitignore 忽略，不要提交。

# 客户端 API 密钥：交给 Cherry Studio / ChatBox / Codex 等客户端使用。
WB2A_API_KEY=sk-请替换为随机值

# 管理面板密钥：只你自己知道，用于登录 http://<服务器>:7863/panel/
# 必须与上面的 WB2A_API_KEY 不同 —— 否则拿到客户端密钥的人可以登录管理后台。
WB2A_PANEL_KEY=pk-请替换为另一个随机值

# 容器运行 uid/gid（挂载目录属主不匹配时用；见 docker-compose.yml 注释）
#PUID=1000
#PGID=1000

# 生成随机密钥：
#   Linux/macOS : openssl rand -base64 24
#   PowerShell  : [Convert]::ToBase64String((1..24|%{Get-Random -Max 256}))
